# Змінні бекенду
APP_PORT=3000
APP_HOST=localhost
APP_FRONT_URL=http://localhost:5173

# --- НАЛАШТУВАННЯ АДМІНІСТРАТОРА ---
RUN_SEED=true
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin

# --- ПІДКЛЮЧЕННЯ ДО БД ---
DB_TYPE=mysql
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Синхронізація під змінні MYSQL_*, щоб не було конфліктів у сервісах
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=true

# --- НАЛАШТУВАННЯ АВТОРИЗАЦІЇ (JWT) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=900

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=1800

# --- НАЛАШТУВАННЯ ПОШТИ (SMTP) ---
SMTP_EMAIL=
SMTP_PASSWORD=