# Змінні бекенду
APP_PORT=3000
APP_HOST=localhost
APP_FRONT_URL=http://localhost:5173

# --- НАЛАШТУВАННЯ АДМІНІСТРАТОРА ---
RUN_SEED=true
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin

# --- ПІДКЛЮЧЕННЯ ДО БД ---
DB_TYPE=mysql
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=true

# --- НАЛАШТУВАННЯ АВТОРИЗАЦІЇ (JWT) ---
JWT_ACCESS_SECRET=secret_access_key
JWT_ACCESS_EXPIRES_IN=900

JWT_REFRESH_SECRET=secret_refresh_key
JWT_REFRESH_EXPIRES_IN=1800

# --- НАЛАШТУВАННЯ ПОШТИ (SMTP) ---
SMTP_EMAIL=
SMTP_PASSWORD=