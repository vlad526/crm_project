<table style="width: 100%; max-width: 600px; margin: 0 auto; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; border-collapse: collapse; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; background-color: #ffffff; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);">

  <tr>
    <td style="padding: 40px 20px; text-align: center; background-color: #ef4444;">
      <h2 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 600; letter-spacing: 0.5px;">
        Security Alert
      </h2>
    </td>
  </tr>

  <tr>
    <td style="text-align: center; padding: 40px 30px;">
      <p style="font-size: 20px; color: #111827; margin-top: 0; margin-bottom: 20px;">
        Hello, <strong>{{name}}</strong>!
      </p>
      <p style="font-size: 16px; color: #4b5563; line-height: 1.6; margin-bottom: 15px;">
        We are writing to inform you that we just ended all your active sessions across all devices.
      </p>
      <p style="font-size: 16px; color: #4b5563; line-height: 1.6; margin-bottom: 30px;">
        If you initiated this action, no further steps are required. However, if you did not do this, we highly recommend that you <strong>change your password immediately</strong> to secure your account.
      </p>

      <div style="margin: 35px 0;">
        <a href="{{frontUrl}}/password/forgot"
           style="background-color: #111827; color: #ffffff; padding: 14px 36px; text-decoration: none; border-radius: 6px; font-size: 16px; font-weight: 600; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px;">
          Change Password
        </a>
      </div>

    </td>
  </tr>

  <tr>
    <td style="padding: 24px; text-align: center; font-size: 13px; color: #9ca3af; background-color: #f9fafb; border-top: 1px solid #e5e7eb;">
      <p style="margin: 0;">&copy; 2026 Programming School CRM. All rights reserved.</p>
      <p style="margin: 8px 0 0 0;">If you need further assistance, please contact your administrator.</p>
    </td>
  </tr>
</table>